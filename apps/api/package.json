{
  "name": "@ut/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b && esbuild src/index.ts --bundle --platform=node --target=node22 --outdir=dist --format=esm",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/error": "^4.0.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@ut/types": "workspace:*",
    "@ut/config": "workspace:*",
    "fastify": "^5.3.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.2",
    "tsx": "^4.19.3"
  }
}
